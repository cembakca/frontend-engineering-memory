// Tells the memory service that main moved. The service owns the checkout
// (registry `url`), so this pipeline needs no clone of its own and no shared
// filesystem with the service — it posts a commit and the service fetches it.
pipeline {
  agent any

  environment {
    FRONTEND_MEMORY_URL    = 'http://memory.internal:4317'
    MEMORY_REPOSITORY_NAME = 'company.web.next'   // the name in config/repositories.json
  }

  stages {
    stage('Sync engineering memory') {
      when { branch 'main' }
      steps {
        // The secret the service checks; store it as a Jenkins credential.
        withCredentials([string(credentialsId: 'memory-webhook-secret', variable: 'MEMORY_WEBHOOK_SECRET')]) {
          sh 'ci/sync-after-main.sh'
        }
      }
    }
  }
}

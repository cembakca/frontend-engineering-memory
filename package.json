{
  "name": "frontend-engineering-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Living technical memory for multiple Next.js repositories: routes, rendering, dependencies, incremental Git sync, FTS and local semantic search.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "memory": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js serve",
    "start:mcp": "node dist/mcp/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "0.1.9",
    "typescript": "5.9.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.15.3",
    "tsx": "4.19.4"
  }
}

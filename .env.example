# SQLite location (default: ./data/engineering-memory.sqlite)
MEMORY_DB_PATH=./data/engineering-memory.sqlite

# Optional better-sqlite3 native binding override for unusual packaged/runtime environments.
# Normal npm installations should leave this unset.
# MEMORY_SQLITE_NATIVE_BINDING=/absolute/path/to/better_sqlite3.node
# MEMORY_SQLITE_VEC_EXTENSION=/absolute/path/to/vec0.dylib

# Repository registry (default: ./config/repositories.json)
MEMORY_REPOSITORIES_FILE=./config/repositories.json

# Immutable local embedding contract. The profile pins model revision,
# dimension, quantization and query/passage prefixes together.
MEMORY_EMBEDDING_PROFILE=multilingual-e5-small-v1
# Use MEMORY_EMBEDDING_MODEL + MEMORY_EMBEDDING_REVISION/DIMENSION only for
# controlled custom-model experiments; do not set both MODEL and PROFILE.

# Set 0 to disable embedding generation during sync/full-index.
MEMORY_EMBEDDINGS_ENABLED=1

# Optional scheduled hash-aware reconciliation. 0 disables the scheduler.
MEMORY_RECONCILE_INTERVAL_MINUTES=0

# Optional, explicit AI enrichment. Normal full/sync/MCP never calls this endpoint.
# MEMORY_AI_EXTRACTOR_URL=http://127.0.0.1:8080/extract
# MEMORY_AI_EXTRACTOR_TOKEN=
MEMORY_AI_MIN_CONFIDENCE=0.8
MEMORY_AI_MAX_FILES_PER_RUN=20
MEMORY_AI_MAX_SOURCE_CHARS=40000
MEMORY_AI_EXTRACTOR_TIMEOUT_MS=60000

# Server
MEMORY_HOST=127.0.0.1
MEMORY_PORT=4317
